{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "datasource",
  "name": "Prtg",
  "id": "maxmarkusprogram-prtg-datasource",
  "autoEnabled": true,
  "alerting": true,
  "annotations": true,
  "logs": true,
  "metrics": true,
  "streaming": true,
  "backend": true,
  "executable": "gpx_prtg",
  "info": {
    "description": "Grafana datasource plugin for PRTG Network Monitor",
    "author": {
      "name": "Mustafa Özdemir"
    },
    "keywords": ["datasource"],
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      { "name": "Documentation", "url": "https://github.com/mustafa-oezdemir/PRTG#readme" },
      { "name": "Source code", "url": "https://github.com/mustafa-oezdemir/PRTG" }
    ],
    "screenshots": [
      { "name": "PRTG datasource settings", "path": "img/screenshots/datasource-settings.png" },
      { "name": "Metrics query and panel", "path": "img/screenshots/metrics-panel.png" }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "dependencies": {
    "grafanaDependency": ">=12.0.0",
    "plugins": []
  }
}
